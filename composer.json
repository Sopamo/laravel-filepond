{
    "name": "sopamo/laravel-filepond",
    "description": "Laravel backend module for filepond uploads",
    "license": "MIT",
    "keywords": [
        "laravel",
        "php",
        "filepond",
        "upload",
        "image"
    ],
    "authors": [
        {
            "name": "Paul Mohr",
            "email": "p.mohr@sopamo.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "league/flysystem": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Sopamo\\LaravelFilepond\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sopamo\\LaravelFilepond\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sopamo\\LaravelFilepond\\LaravelFilepondServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php ./vendor/bin/phpunit",
        "analyse": "@php ./vendor/bin/phpstan analyse",
        "post-autoload-dump": [
            "@php ./vendor/bin/testbench package:discover --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "azure-oss/storage-blob-flysystem": "^1.6|^2.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3|^12.5.12",
        "orchestra/testbench": "^10.0|^11.0"
    }
}
